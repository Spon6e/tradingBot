# Создайте бота через @BotFather и вставьте токен только в свою копию .env.
TELEGRAM_BOT_TOKEN=PASTE_BOTFATHER_TOKEN_HERE

# Ваш числовой Telegram ID. Его можно узнать командой /id у запущенного бота.
# Без ID разрешена только команда /id. После изменения перезапустите приложение.
TELEGRAM_ALLOWED_USER_IDS=
ALLOW_PUBLIC_ACCESS=false

MARKET_BOT_DB=data/market_bot.sqlite3
REFRESH_INTERVAL_SECONDS=60

# Комиссия за каждую сторону сделки: 0.001 = 0,1%.
PAPER_COMMISSION_RATE=0.001

# Срок позиции после исполнения виртуальной заявки: от 1 до 168 часов.
PAPER_TIMEOUT_HOURS=72
